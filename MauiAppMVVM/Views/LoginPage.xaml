<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMVVM.Views.LoginPage"
             xmlns:models="clr-namespace:MauiAppMVVM.Models"
             xmlns:views="clr-namespace:MauiAppMVVM.Views"
             xmlns:vm="clr-namespace:MauiAppMVVM.ViewModels"
             x:DataType="vm:LoginPageVm"
             Title="LoginPage">
    
    <VerticalStackLayout>
        <Label 
            Text="Login Page"
            FontSize="Large"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Border 
            MaximumHeightRequest="200"
            MaximumWidthRequest="200">

            <Entry
                Placeholder="Name"
                x:Name="Entry"
                Text="{Binding Name}"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Border>

        <Border 
        MaximumHeightRequest="200"
        MaximumWidthRequest="200">

            <Entry 
                Placeholder="password"
                x:Name="passordEntry"
                Text="{Binding Password}"
                VerticalOptions="Center"
                HorizontalOptions="Center" />


        </Border>
        
        
        <Button 
                Style="{StaticResource buttonStyle}"
                Command="{Binding LoginCommand}"
            Text="Login"
                />

        <Label 
            FontSize="Large"
            TextColor="{Binding MessagesColor}"
              IsVisible ="{Binding MessagesVisible}"
            Text="{Binding MessageError}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

           
    </VerticalStackLayout>
</ContentPage>