<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMVVM.Views.UserDataPage"
             xmlns:vm="clr-namespace:MauiAppMVVM.ViewModels"
             xmlns:views ="clr-namespace:MauiAppMVVM.Views"
                          x:DataType="vm:UserDataPageVM"
             xmlns:models="clr-namespace:MauiAppMVVM.Models"
             Title="UserDataPage">
    <VerticalStackLayout>
        <Label 
            Text="User data page"
            FontSize="Large" 
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
            Text="{Binding User.Name}"
            TextColor="Green" 
            FontSize="Medium" 
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label 
             Text="{Binding User.Password}"
             TextColor="Green" 
             FontSize="Medium" 
             VerticalOptions="Center"   
             HorizontalOptions="Center"/>   
    </VerticalStackLayout>
    
</ContentPage>