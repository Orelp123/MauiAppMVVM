<?xml version="1.0" encoding="utf-8" ?>
<ContentPage  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMVVM.Views.UserList"
             xmlns:models="clr-namespace:MauiAppMVVM.Models"
             xmlns:views="clr-namespace:MauiAppMVVM.Views"
             xmlns:vm="clr-namespace:MauiAppMVVM.ViewModels"
             x:DataType="vm:UserListVM"
             Title="UserList">
    <VerticalStackLayout>
       
        <Label 
            Text="User List"
            FontSize="Medium" 
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Picker  Title="choose person"
            ItemsSource="{Binding Users}"
                 ItemDisplayBinding="{Binding Name}"
                 SelectedItem="{Binding User}"
      ></Picker>

        <Label 
        Text="{Binding DisplayUser}"
        VerticalOptions="Center" 
        HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Users}" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:User">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="delete" BackgroundColor="Red"
                                           Command="{Binding x:DataType='vm:UserListVM',Source={RelativeSource AncestorType={x:Type vm:UserListVM}},Path=ShowUserDataCommand}" 
                                           CommandParameter="{Binding .}"></SwipeItem>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border BackgroundColor="FloralWhite"
                                StrokeThickness="1">
                            <Grid ColumnDefinitions="*,*,*">
                                <Label Text="{Binding Name}" TextColor="Green" FontSize="Medium" />
                                <Label Grid.Column="1" Text="{Binding Password}" TextColor="MediumVioletRed"/>
                                <Button Grid.Column="2" Text="Show Details" TextColor="LavenderBlush" FontSize="Medium"
                                    Command="{Binding x:DataType='vm:UserListVM',Source={RelativeSource AncestorType={x:Type vm:UserListVM}},Path=ShowUserDataCommand}"
                                    CommandParameter="{Binding .}"
                                    >

                                </Button>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>